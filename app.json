{
  "expo": {
    "name": "Bills Assistant",
    "slug": "bills-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Bills assistant uses the camera to capture receipts you choose to save.",
        "NSPhotoLibraryUsageDescription": "Allow access if you choose a photo from your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Assistant to capture photos of your receipts.",
          "photosPermission": "Allow Assistant to attach receipt photos from your library."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
